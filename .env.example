# =====================================================================
# .env.example — Copier en .env et adapter
# NE JAMAIS COMMIT .env (voir .gitignore)
# openssl rand -hex 32
# =====================================================================

# --- Base de données ---
POSTGRES_DB=dhr
POSTGRES_USER=dhr
POSTGRES_PASSWORD=dhr_dev_password
POSTGRES_PORT=5432

# --- Back-end ---
BACKEND_PORT=8000
ENV=development
LOG_LEVEL=info

# --- Front-end ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/v1

# --- Auth ---
# Clé API de lecture (header X-API-Key) — CHANGER EN PROD
API_KEY_READ=dhr_dev_read_key_change_me
# Secret JWT pour l'écriture — CHANGER EN PROD (openssl rand -hex 32)
JWT_SECRET=change_me_in_production
JWT_EXPIRE_MIN=60

# --- Export ---
# Nombre maximum de lignes exportables (au-delà → 413)
MAX_EXPORT_ROWS=100000

# --- Divers ---
TZ=Africa/Abidjan